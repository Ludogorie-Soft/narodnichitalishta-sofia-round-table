# Copy this file to .env.local for local development.
# Never put real secrets in this file or in NEXT_PUBLIC_* variables.

# Neon PostgreSQL pooled/serverless connection string.
# Use the development branch locally. Preview and Production must have
# separate values in the Vercel project settings.
DATABASE_URL=

# Better Auth secret. Generate locally, for example:
#   openssl rand -base64 32
# Store only in local secret files and Vercel environment variables.
BETTER_AUTH_SECRET=

# Public origin used by Better Auth (no trailing slash).
# Local: http://localhost:3000
# Production: https://sofia-round-table.narodnichitalishta.bg
BETTER_AUTH_URL=http://localhost:3000

# Canonical public site URL (no trailing slash). Used for metadata and redirects.
# Must not contain secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob read/write token from the Blob store integration.
# Configure separately for Preview and Production.
BLOB_READ_WRITE_TOKEN=
